<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- HU002: solo lectura de frecuencia cardíaca y HRV -->
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE_VARIABILITY" />
    <!-- HU026: lectura cada 15 minutos con la app cerrada -->
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND" />

    <!-- Permite comprobar si Health Connect está instalado (Android 9 a 13) -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.GestionEstres">

        <activity
            android:name=".ui.LoginActivity"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.RegistroActivity"
            android:windowSoftInputMode="adjustResize" android:label="@string/titulo_registro" />
        <activity android:name=".ui.InicioActivity" android:label="@string/app_name" />
        <activity android:name=".ui.ChequeoActivity"
            android:windowSoftInputMode="adjustResize" android:label="@string/titulo_chequeo" />
        <activity android:name=".ui.DispositivoActivity" android:label="@string/titulo_dispositivo" />

        <!-- Health Connect exige una pantalla que explique el uso de los datos (Android 9 a 13) -->
        <activity
            android:name=".ui.PermisosSaludActivity"
            android:exported="true"
            android:label="@string/titulo_privacidad">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!-- La misma pantalla para Android 14 o superior -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity=".ui.PermisosSaludActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
